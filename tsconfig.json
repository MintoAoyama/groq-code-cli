{
	"compilerOptions": {
	  "target": "ES2022",
	  "module": "ESNext",
	  "moduleResolution": "bundler",
	  "outDir": "./dist",
	  "rootDir": "./src",
	  "strict": true,
	  "esModuleInterop": true,
	  "skipLibCheck": true,
	  "forceConsistentCasingInFileNames": true,
	  "declaration": true,
	  "declarationMap": true,
	  "sourceMap": true,
	  "resolveJsonModule": true,
	  "allowSyntheticDefaultImports": true,
	  // Tests run through tsx, which compiles each file alone.
	  "isolatedModules": true,
	  "jsx": "react-jsx"
	},
	"include": [
	  "src/**/*"
	],
	"exclude": [
	  "node_modules",
	  "dist"
	]
  }