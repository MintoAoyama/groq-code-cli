{
	"name": "groq-code-cli",
	"version": "1.0.2",
	"license": "MIT",
	"bin": {
		"groq": "dist/core/cli.js"
	},
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc && node scripts/write-build-info.mjs && chmod +x dist/core/cli.js",
		"dev": "tsc --watch",
		"test": "ava"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"chalk": "^5.4.1",
		"groq-sdk": "^1.0.0",
		"ink": "^6.0.1",
		"react": "^19.1.0",
		"undici": "^8.12.4"
	},
	"devDependencies": {
		"@types/react": "^19.1.8",
		"ava": "^8.0.0",
		"ts-node": "^10.9.1",
		"typescript": "^5.0.3"
	},
	"ava": {
		"extensions": [
			"ts",
			"tsx"
		],
		"nodeArguments": [
			"--loader=ts-node/esm"
		],
		"files": [
			"test/**/*.test.ts"
		]
	}
}
