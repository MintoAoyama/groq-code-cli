{
	"name": "groq-code-cli",
	"version": "1.0.2",
	"license": "MIT",
	"bin": {
		"groq": "dist/core/cli.js"
	},
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc && node scripts/write-build-info.mjs && chmod +x dist/core/cli.js",
		"dev": "tsc --watch",
		"test": "tsc -p tsconfig.test.json && ava"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"chalk": "^6.0.0",
		"groq-sdk": "^1.0.0",
		"ink": "^8.0.0",
		"react": "^19.1.0",
		"undici": "^8.12.4"
	},
	"devDependencies": {
		"@types/node": "^26.0.0",
		"@types/react": "^19.1.8",
		"ava": "^8.0.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.0"
	},
	"ava": {
		"extensions": [
			"ts",
			"tsx"
		],
		"nodeArguments": [
			"--import=tsx"
		],
		"files": [
			"test/**/*.test.ts"
		],
		"workerThreads": false
	}
}
