{
	"name": "groq-code-cli",
	"version": "1.0.2",
	"license": "MIT",
	"bin": {
		"groq": "dist/core/cli.js"
	},
	"type": "module",
	"engines": {
		"node": ">=16"
	},
	"scripts": {
		"build": "tsc && chmod +x dist/core/cli.js",
		"dev": "tsc --watch",
		"test": "ava"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"chalk": "^5.4.1",
		"commander": "^14.0.0",
		"groq-sdk": "^0.27.0",
		"https-proxy-agent": "^7.0.6",
		"ink": "^6.0.1",
		"react": "^19.1.0",
		"socks-proxy-agent": "^8.0.5"
	},
	"devDependencies": {
		"@types/react": "^19.1.8",
		"ava": "^5.2.0",
		"ts-node": "^10.9.1",
		"typescript": "^5.0.3"
	},
	"ava": {
		"extensions": {
			"ts": "module",
			"tsx": "module"
		},
		"nodeArguments": [
			"--loader=ts-node/esm"
		],
		"files": [
			"src/**/*.test.ts",
			"!**/*.d.ts"
		]
	}
}
